{
  "manifest_version": 3,
  "name": "previwerpdf",
  "version": "1.0.0",
  "description": "Evita la descarga automática de PDF y fuerza su previsualización en el navegador.",
  "browser_specific_settings": {
  "gecko": {
    "id": "pdf-inline@tu-usuario.github.io",
    "strict_min_version": "113.0",
    "data_collection_permissions": {
      "required": ["none"]
    }
  }
},
  "permissions": [
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pdf_inline_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
